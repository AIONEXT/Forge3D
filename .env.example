# Server Configuration
FORGE3D_HOST=0.0.0.0
FORGE3D_PORT=8000
FORGE3D_DEBUG=false
FORGE3D_SECRET_KEY=change-me-in-production

# AI Provider (choose one or leave unset for offline mode)
AI_PROVIDER=offline

# OpenAI
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Together
TOGETHER_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Ollama / Local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LOCAL_LLM_BASE_URL=http://localhost:8001
LOCAL_LLM_MODEL=my-model
